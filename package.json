    "check:release": "node scripts/check-release.cjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.8.0",
    "expo": "~58.0.25",
